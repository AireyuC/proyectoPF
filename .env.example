# ===================================================
# PHONEFIX - PLANTILLA DE CONFIGURACIÓN (.env.example)
# Copia este archivo a .env y ajusta los valores según tu entorno
# ===================================================

# --- Django Backend Core ---
DEBUG=True
SECRET_KEY=cambiar-por-una-clave-secreta-segura
ALLOWED_HOSTS=*
TIME_ZONE=America/La_Paz

# --- CORS (Orígenes Permitidos) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Base de Datos PostgreSQL ---
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db_pfix
DB_PORT=5432

# --- MinIO Object Storage (S3 Compatible) ---
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio_pfix:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=phonefix-media

# --- Frontend Vite ---
VITE_API_URL=http://localhost:8000/graphql/
VITE_MINIO_URL=http://localhost:9000
